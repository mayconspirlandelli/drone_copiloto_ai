# ── Agente de plano de voo ─────────────────────────────────────────────
# Provedor padrão: gemini | openai | anthropic | ollama
# (o site também deixa trocar o modelo no topo do chat; só aparecem prontos os que têm chave)
LLM_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
ADK_MODEL=gemini-2.5-flash

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Ollama (local, sem chave) — use um modelo com visão e ferramentas
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=mistral-small3.1

# NUNCA suba chaves reais para o git (.env está no .gitignore)

# Porta do servidor (Railway define automaticamente)
PORT=3001
